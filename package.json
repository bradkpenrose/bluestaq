{
  "name": "bluestaq",
  "version": "1.0.0",
  "description": "bluestaq project",
  "type": "module",
  "scripts": {
    "dev": "tsx watch ./src/index.ts 80",
    "build": "tsc -p tsconfig.app.json",
    "start": "node ./dist/index.js 80",
    "test:data": "node --test ./src/data/**/**/*.test.ts",
    "test:service": "node --test ./src/services/*.test.ts",
    "test:all": "npm run test:data && npm run test:service",
    "test:server": "node index.ts 3000",
    "test:routes": "node --test ./src/routes/notes.test.ts",
    "test:e2e": "start-server-and-test test:server http://localhost:3000 test:routes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "start-server-and-test": "^3.0.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
